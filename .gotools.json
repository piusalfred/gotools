{
  "version": 1,
  "strategy": "split",
  "dir": "tools",
  "go_version": "inherit",
  "module_prefix": "github.com/piusalfred/gotools",
  "settings": {
    "jobs": 1,
    "lock_stale_timeout": 300,
    "lock_timeout": 10,
    "no_lock": false,
    "offline": false,
    "operation_timeout": 120,
    "trace": true,
    "verbose": true
  },
  "tools": {
    "gci": {
      "source": "go",
      "package": "github.com/daixiang0/gci",
      "version": "v0.14.0"
    },
    "addlicense": {
      "source": "go",
      "package": "github.com/google/addlicense",
      "version": "v1.2.0"
    },
    "govulncheck": {
      "source": "go",
      "package": "golang.org/x/vuln/cmd/govulncheck",
      "version": "v1.6.0"
    },
    "staticcheck": {
      "source": "go",
      "package": "honnef.co/go/tools/cmd/staticcheck",
      "version": "v0.7.0"
    },
    "gofumpt": {
      "source": "go",
      "package": "mvdan.cc/gofumpt",
      "version": "v0.10.0"
    }
  }
}
