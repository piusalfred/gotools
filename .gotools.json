{
  "version": 1,
  "strategy": "module",
  "dir": "tools",
  "go_version": "inherit",
  "module_prefix": "github.com/piusalfred/gotools",
  "settings": {
    "jobs": 1,
    "lock_stale_timeout": 300,
    "lock_timeout": 10,
    "no_lock": false,
    "offline": false,
    "operation_timeout": 120,
    "trace": true,
    "verbose": true
  },
  "tools": {
    "golangci-lint": {
      "source": "go",
      "package": "github.com/golangci/golangci-lint/v2/cmd/golangci-lint",
      "version": "v2.15.0"
    },
    "addlicense": {
      "source": "go",
      "package": "github.com/google/addlicense",
      "version": "v1.2.0"
    },
    "govulncheck": {
      "source": "go",
      "package": "golang.org/x/vuln/cmd/govulncheck",
      "version": "v1.9.0"
    }
  }
}
