{
  "version": 1,
  "strategy": "split",
  "dir": "tools",
  "go_version": "inherit",
  "module_prefix": "github.com/piusalfred/gotools/testfolder",
  "tools": {
    "gci": {
      "source": "go",
      "package": "github.com/daixiang0/gci",
      "version": "v0.14.0"
    },
    "gosec": {
      "source": "go",
      "package": "github.com/securego/gosec/v2/cmd/gosec",
      "version": "v2.27.1"
    },
    "goimports": {
      "source": "go",
      "package": "golang.org/x/tools/cmd/goimports",
      "version": "v0.45.0"
    },
    "staticcheck": {
      "source": "go",
      "package": "honnef.co/go/tools/cmd/staticcheck",
      "version": "v0.7.0"
    }
  }
}
